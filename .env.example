# Optional xAI / Grok API (OpenAI-compatible at https://api.x.ai/v1)
# App works fully WITHOUT these keys (deterministic prompt + caption builders).
XAI_API_KEY=your_xai_api_key_here
# GROK_API_KEY is accepted as an alias:
# GROK_API_KEY=your_xai_api_key_here

# Optional Google Gemini API (google-genai SDK) for vision analysis
# Used when Auto falls through after Grok, or when provider = Gemini.
# GEMINI_API_KEY=your_gemini_api_key_here
